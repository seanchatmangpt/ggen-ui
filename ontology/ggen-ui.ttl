@prefix ui: <https://ggen.io/ontology/ggen-ui#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ui:GgenUI
  a prov:Entity ;
  dct:title "GGen UI" ;
  dct:description "Ontology-driven visual composition workbench for admitted ggen capabilities." .

ui:VisualDocument a prov:Entity ;
  skos:prefLabel "Visual document" .

ui:VisualNode a prov:Entity ;
  skos:prefLabel "Visual node" .

ui:ActionIntent a prov:Plan ;
  skos:prefLabel "Typed action intent" .

ui:pageHeader
  a ui:ComponentKind, skos:Concept ;
  ui:componentId "page-header" ;
  ui:label "Page header" ;
  ui:description "Title, context, status, and page-level actions." ;
  ui:icon "i-lucide-panel-top" .

ui:statCard
  a ui:ComponentKind, skos:Concept ;
  ui:componentId "stat-card" ;
  ui:label "Stat card" ;
  ui:description "A semantic metric with standing and provenance context." ;
  ui:icon "i-lucide-square-chart-gantt" .

ui:dataTable
  a ui:ComponentKind, skos:Concept ;
  ui:componentId "data-table" ;
  ui:label "Data table" ;
  ui:description "Tabular projection over an admitted semantic query." ;
  ui:icon "i-lucide-table-properties" .

ui:form
  a ui:ComponentKind, skos:Concept ;
  ui:componentId "form" ;
  ui:label "Semantic form" ;
  ui:description "Typed input surface that constructs intents without ambient DO authority." ;
  ui:icon "i-lucide-list-checks" .

ui:chart
  a ui:ComponentKind, skos:Concept ;
  ui:componentId "chart" ;
  ui:label "Chart" ;
  ui:description "Visual encoding of admitted quantitative observations." ;
  ui:icon "i-lucide-chart-no-axes-combined" .

ui:commandPalette
  a ui:ComponentKind, skos:Concept ;
  ui:componentId "command-palette" ;
  ui:label "Command palette" ;
  ui:description "Search and SELECT surface over admitted capabilities." ;
  ui:icon "i-lucide-command" .

ui:receiptPanel
  a ui:ComponentKind, skos:Concept ;
  ui:componentId "receipt-panel" ;
  ui:label "Receipt panel" ;
  ui:description "Receipt identity, authority, consequence, replay, and standing projection." ;
  ui:icon "i-lucide-fingerprint" .

ui:chatPanel
  a ui:ComponentKind, skos:Concept ;
  ui:componentId "chat-panel" ;
  ui:label "Chat panel" ;
  ui:description "Conversational SELECT/CONSTRUCT surface with no ambient execution authority." ;
  ui:icon "i-lucide-messages-square" .

ui:manufactureComponentCatalog
  a prov:Activity ;
  prov:used ui:GgenUI ;
  prov:generated ui:pageHeader, ui:statCard, ui:dataTable, ui:form, ui:chart, ui:commandPalette, ui:receiptPanel, ui:chatPanel .
